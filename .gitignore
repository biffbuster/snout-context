*.log
.DS_Store

# Regenerated from bench/manifest.json by bench/fetch.mjs. Never commit — it's metadata
# plus a 2 KB head sample per file, not source, but still tens of MB and instantly stale
# the moment a repo's default branch moves past the pinned commit.
bench/corpus/

# Labeling runs — small, regenerable, contains model output over corpus samples.
bench/labels/

# Token calibration runs — regenerable.
bench/tokens/

# A/B run results. Only the runs the docs cite are published, so every quoted number can be checked.
bench/ab-results/*
.env
.env.*
# local agent hook configs written by `snout init` (machine-specific paths)
.cursor/
.gemini/
.codex/

# Context-audit precision study (paused): corpus clones, scripts and runs stay local.
bench/ai-corpus/
bench/ai-results/
bench/ai-corpus.mjs
bench/ai-label.mjs
bench/ai-manifest.json

# Track A label sets carry the first 2 KB of third-party files; kept local, rebuilt from the pinned corpus.
bench/gold/

# Keep root scratch plans local; track the reviewed Codex plan in docs.
/codex-*.md
docs/memory-for-codex.md
bench/frozen/

