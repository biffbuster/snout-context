+  test.each([false, true])('async setup (wrapped: %s)', async wrapped => {
+    const loading = ref(false)
+    const slotFilled = ref(true)
+    const Dummy = defineComponent({
+      async setup() {
+        await new Promise(() => {})
+      },
+    })
+    const Common = defineComponent({
+      components: {
+        Dummy: wrapped
