+  })
+
+  test('reactive props respect catch defaults and var scope in class static blocks', () => {
+    const statements = `
+      let caught, local
+      class Example {
+        static {
+          try { throw [] } catch ([value = message]) {
+            caught = value
+            var message = 'local'
+            local = message
+          }
+        }
+      }
+      function inspect() { return [caught, local] }
+      function readProp() { return message }
+    `
