+  test('reactive props keep catch pattern bindings local', () => {
+    const { content } = compile(
+      `<script setup>
+      const { message } = defineProps(['message'])
+      function inspect() {
+        try {
+          throw { message: 'caught' }
+        } catch ({ message }) {
