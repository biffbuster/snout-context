+      const { message } = defineProps(['message'])
+      function inspectBody() {
+        switch ('first') {
+          case 'first': return message
+          case 'second': let message = 'case'
+        }
+      }
+      function inspectTest() {
+        switch ('first') {
+          case message: return 'matched'
+          case 'second': let message = 'case'
+        }
+      }
