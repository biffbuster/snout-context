+// numericKey returns a key that is equal for numerically equal values
+// regardless of their Go type, without losing precision.
+func numericKey(v reflect.Value) any {
+	switch k := v.Kind(); {
+	case hreflect.IsInt(k):
+		return v.Int()
+	case hreflect.IsUint(k):
+		u := v.Uint()
+		if u > math.MaxInt64 {
+			return u
+		}
+		return int64(u)
+	default:
+		f := v.Float()
+		if f == math.Trunc(f) {
+			if f >= -(1<<63) && f < 1<<63 {
+				return int64(f)
+			}
+			if f >= 1<<63 && f < 1<<64 {
+				return uint64(f)
+			}
+		}
+		return f
+	}
+}
