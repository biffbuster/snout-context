+{{ .Render "foo/" }}
+-- layouts/s1/p1/foo.html --
+should-not-match{{- /**/ -}}
+`
+
+	b, err := TestE(t, files)
+	b.Assert(err, qt.ErrorMatches, `.*template "foo/" not found.*`)
+}
+
+// See issue 15056.
+func TestRenderViewSubdirCaseInsensitiveArgument(t *testing.T) {
+	t.Parallel()
+
+	files := `
+-- hugo.toml --
+disableKinds = ['home','rss','section','sitemap','taxonomy','term']
