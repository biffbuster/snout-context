            "ls; cat package.json; ls src test* 2>/dev/null; head -60 src/*.js",
            "head -30 test/billing.test.js",
            "cat > src/retries.js <<'EOF'\nimport { chargeInvoice } from \"./billing.js\";\nimport { lastAttempt } from \"./invoices.js\";\n\nconst HOUR_MS = 60 * 60 * 1000;\n// Delay after the last attempt for the 1st, 2nd and 3rd scheduled retry.\nexport const RETRY_DELAYS_MS = [1 * HOUR_MS, 6 * HOUR_MS, 24 * HOUR_MS];\n\n/**\n * Runs the scheduled retry for each failed invoice that is due: at most one per invoice per run.\n * Retries reuse the invoice's idempotency key (via chargeInvoice), so a charge that went through\n * at the provider but timed out is recovered rather than charged twice. If the third scheduled\n * retry fails too, the invoice becomes `uncollectible`. Returns the invoices retried.\n */\nexport async function retryFailedInvoices(invoices, gateway, now = new Date()) {\n  const retried = [];\n  for (const invoice of invoices) {\n    if (invoice.status !== \"failed\") continue;\n    const done = invoice.retryCount ?? 0;\n    const last = lastAttempt(invoice);\n    if (done >= RETRY_DELAYS_MS.length || !last) continue;\n    if (now.getTime() < new Date(last.at).getTime() + RETRY_DELAYS_MS[done]) continue;\n\n    invoice.retryCount = done + 1;\n    await chargeInvoice(invoice, gateway, { now, tries: 1 });\n    if (invoice.status === \"failed\" && invoice.retryCount >= RETRY_DELAYS_MS.length) invoice.status = \"uncollectible\";\n    retried.push(invoice);\n  }\n  return retried;\n}\nEOF\ncat > test/retries.test.js <<'EOF'\nimport { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { chargeInvoice } from \"../src/billing.js\";\nimport { Gateway } from \"../src/gateway.js\";\nimport { openInvoice } from \"../src/invoices.js\";\nimport { retryFailedInvoices } from \"../src/retries.js\";\n\nconst sub = { id: \"sub_r\", customer: \"cus_r\", priceCents: 1000, active: true };\nconst T0 = new Date(\"2026-10-01T00:00:00Z\");\nconst at = (h) => new Date(T0.getTime() + h * 3600e3);\n\nasync function failedInvoice(gw) {\n  return chargeInvoice(openInvoice(sub, \"2026-10\"), gw, { now: T0 });\n}\nconst down = [\"unavailable\", \"unavailable\", \"unavailable\"];\n\ntest(\"not retried before it is due\", async () => {\n  const gw = new Gateway({ script: down });\n  const inv = await failedInvoice(gw);\n  const calls = gw.calls;\n  await retryFailedInvoices([inv], gw, at(0.99));\n  assert.equal(gw.calls, calls);\n});\n\ntest(\"retry succeeds when due\", async () => {\n  const gw = new Gateway({ script: down });\n  const inv = await failedInvoice(gw);\n  await retryFailedInvoices([inv], gw, at(1));\n  assert.equal(inv.status, \"paid\");\n});\n\ntest(\"schedule is 1h, 6h, 24h after the last attempt; third failure is uncollectible\", async () => {\n  const gw = new Gateway({ script: [...down, \"unavailable\", \"unavailable\", \"unavailable\"] });\n  const inv = await failedInvoice(gw);\n  await retryFailedInvoices([inv], gw, at(1));\n  assert.equal(inv.status, \"failed\");\n  let calls = gw.calls;\n  await retryFailedInvoices([inv], gw, at(6)); // only 5h after last attempt\n  assert.equal(gw.calls, calls);\n  await retryFailedInvoices([inv], gw, at(7));\n  assert.equal(inv.status, \"failed\");\n  calls = gw.calls;\n  await retryFailedInvoices([inv], gw, at(30)); // 23h after\n  assert.equal(gw.calls, calls);\n  await retryFailedInvoices([inv], gw, at(31));\n  assert.equal(inv.status, \"uncollectible\");\n  calls = gw.calls;\n  await retryFailedInvoices([inv], gw, at(100));\n  assert.equal(gw.calls, calls);\n});\n\ntest(\"one retry per invoice per run\", async () => {\n  const gw = new Gateway({ script: [...down, \"unavailable\", \"unavailable\"] });\n  const inv = await failedInvoice(gw);\n  await retryFailedInvoices([inv], gw, at(100));\n  assert.equal(inv.retryCount, 1);\n  assert.equal(inv.status, \"failed\");\n});\n\ntest(\"a timed-out retry is recovered without double charging\", async () => {\n  const gw = new Gateway({ script: [...down, \"timeout\"] });\n  const inv = await failedInvoice(gw);\n  await retryFailedInvoices([inv], gw, at(1));\n  assert.equal(inv.status, \"failed\");\n  await retryFailedInvoices([inv], gw, at(7));\n  assert.equal(inv.status, \"paid\");\n  assert.equal(gw.charges.length, 1);\n});\n\ntest(\"paid and declined invoices are left alone\", async () => {\n  const gw = new Gateway({ script: [\"ok\", \"declined\"] });\n  const paid = await chargeInvoice(openInvoice(sub, \"2026-09\"), gw, { now: T0 });\n  const declined = await chargeInvoice(openInvoice({ ...sub, id: \"sub_d\" }, \"2026-10\"), gw, { now: T0 });\n  const calls = gw.calls;\n  await retryFailedInvoices([paid, declined], gw, at(100));\n  assert.equal(gw.calls, calls);\n  assert.equal(paid.status, \"paid\");\n  assert.equal(declined.status, \"declined\");\n});\nEOF\nnpm test 2>&1 | tail -20"
