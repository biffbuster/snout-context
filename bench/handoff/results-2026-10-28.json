n\ndef test_export_invoices_empty_month(data_dir, capsys):\n    assert main([\"--data\", str(data_dir), \"export-invoices\", \"2025-01\"]) == 0\n    assert capsys.readouterr().out == \"invoice;vessel;amount\\n\"\nEOF\ncat >> tests/test_report.py <<'EOF'\n\n\ndef test_format_money_de():\n    from berthbook.report import format_money_de\n    assert format_money_de(123450) == \"1234,50\"\n    assert format_money_de(5) == \"0,05\"\n    assert format_money_de(100000000) == \"1000000,00\"\n    assert format_money_de(-250) == \"-2,50\"\n\n\ndef test_format_csv_de_quotes_semicolons():\n    from berthbook.report import format_csv_de\n    assert format_csv_de([\"a\", \"b\"], [[\"x;y\", 'q\"z']]) == 'a;b\\n\"x;y\";\"q\"\"z\"\\n'\nEOF\npython -m pytest -q 2>&1 | tail -8",
