{
  "name": "usesnout",
  "version": "0.3.2",
  "description": "Context gating and token optimization for AI coding agents: trims bulky files, logs, docs, command and MCP output before they enter context, and reports what it saved.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "snout": "dist/snout.mjs"
  },
  "homepage": "https://github.com/biffbuster/snout-context",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biffbuster/snout-context.git"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "cursor",
    "gemini-cli",
    "codex",
    "context",
    "tokens",
    "llm",
    "mcp",
    "token-optimization",
    "context-engineering"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/dashboard/app",
    "test": "node scripts/test.mjs",
    "bench": "node test/bench.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "eval": "node eval/run.mjs",
    "eval:json": "node eval/run.mjs --json",
    "verify": "npm run typecheck && npm run build && npm run check:bench && npm run check:claims && npm test && npm run eval && npm run bench",
    "check:bench": "node scripts/check-bench.mjs",
    "doctor": "node dist/snout.mjs doctor",
    "compat": "node scripts/compat.mjs",
    "bench:clean": "node scripts/bench-clean.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "hooks",
    "!hooks/*.test.tsx",
    "themes",
    "commands",
    "skills",
    ".claude-plugin/plugin.json",
    ".claude-plugin/marketplace.json",
    ".claude-plugin/icon.png",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/biffbuster/snout-context/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
